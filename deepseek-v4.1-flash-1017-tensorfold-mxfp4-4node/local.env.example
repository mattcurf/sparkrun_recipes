# Copy to ignored local.env and replace every placeholder. Never put a key here.
# RFC 5737 documentation addresses; these are not actual cluster nodes.
WORKER=YOUR_SSH_USER@192.0.2.11
WORKER2=YOUR_SSH_USER@192.0.2.12
WORKER3=YOUR_SSH_USER@192.0.2.13
MASTER_ADDR=192.0.2.10
SOCKET_IFNAME=YOUR_CONTROL_INTERFACE
HOST=0.0.0.0
PORT=8000
SERVED_NAME=deepseek-v4.1-flash-1017-mxfp4-tp4
API_KEY_FILE=/path/to/model-api-key
HF_CACHE=/path/to/local-nvme/huggingface
WORKER_HF_CACHE=/path/to/local-nvme/huggingface
WORKER_HF_CACHE2=/path/to/local-nvme/huggingface
WORKER_HF_CACHE3=/path/to/local-nvme/huggingface
GRAPHS=0
DERISKED=0
ABLIT=0
ENGRAM_PACKED=0
